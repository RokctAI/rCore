{
  "doctype": "DocType",
  "name": "Product Extra Group",
  "engine": "InnoDB",
  "is_submittable": 0,
  "issingle": 0,
  "istable": 0,
  "module": "products",
  "permissions": [
    {
      "create": 1,
      "delete": 1,
      "email": 1,
      "export": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "role": "System Manager",
      "share": 1,
      "write": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Title",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "type",
      "fieldtype": "Select",
      "label": "Type",
      "options": "color\ntext\nimage",
      "default": "text",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "shop",
      "fieldtype": "Link",
      "label": "Shop",
      "options": "Shop",
      "reqd": 1
    },
    {
      "fieldname": "active",
      "fieldtype": "Check",
      "label": "Active",
      "default": "1"
    },
    {
      "fieldname": "translations",
      "fieldtype": "Table",
      "label": "Translations",
      "options": "Product Extra Group Translation"
    }
  ]
}