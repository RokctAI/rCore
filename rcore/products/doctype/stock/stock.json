{
  "doctype": "DocType",
  "name": "Stock",
  "engine": "InnoDB",
  "is_submittable": 0,
  "issingle": 0,
  "istable": 0,
  "module": "products",
  "permissions": [
    {
      "create": 1,
      "delete": 1,
      "email": 1,
      "export": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "role": "System Manager",
      "share": 1,
      "write": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "product",
      "fieldtype": "Link",
      "label": "Product",
      "options": "Product",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "shop",
      "fieldtype": "Link",
      "label": "Shop",
      "options": "Shop",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "sku",
      "fieldtype": "Data",
      "label": "SKU",
      "in_list_view": 1
    },
    {
      "fieldname": "min_qty",
      "fieldtype": "Int",
      "label": "Low Stock Threshold",
      "default": "5"
    },
    {
      "fieldname": "price",
      "fieldtype": "Currency",
      "label": "Price",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "quantity",
      "fieldtype": "Int",
      "label": "Quantity",
      "default": "0",
      "in_list_view": 1
    },
    {
      "fieldname": "image",
      "fieldtype": "Attach Image",
      "label": "Image"
    },
    {
      "fieldname": "addon",
      "fieldtype": "Check",
      "label": "Is Addon",
      "default": "0"
    },
    {
      "fieldname": "stock_extras",
      "fieldtype": "Table",
      "label": "Extras",
      "options": "Stock Extra Link"
    }
  ]
}