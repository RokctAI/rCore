{
  "doctype": "DocType",
  "name": "Scoring Rule",
  "engine": "InnoDB",
  "is_submittable": 0,
  "issingle": 0,
  "istable": 0,
  "editable_grid": 1,
  "module": "polaris",
  "autoname": "field:metric_name",
  "description": "One row of credit-scoring configuration consumed by the decision engine (decision_engine/engine.py and decision_engine/scorecard.py). Knockout rows (is_knockout=1) are the regulatory hard gates from polaris/docs/credit-risk-algorithm.md; weighted rows carry the 45/30/15/10 component weights; zero-weight disabled rows double as named config values (e.g. first_loan_max_amount) whose 'threshold' holds the value once an operator sets it.",
  "permissions": [
    {
      "create": 1,
      "delete": 1,
      "email": 1,
      "export": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "role": "System Manager",
      "share": 1,
      "write": 1
    },
    {
      "create": 1,
      "delete": 1,
      "email": 1,
      "export": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "role": "Loan Manager",
      "share": 1,
      "write": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "metric_name",
      "fieldtype": "Data",
      "label": "Metric Name",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "condition",
      "fieldtype": "Select",
      "label": "Condition",
      "options": "Greater Than\nLess Than\nEquals\nGreater Than or Equals\nLess Than or Equals",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "threshold",
      "fieldtype": "Float",
      "label": "Threshold",
      "in_list_view": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "weight",
      "fieldtype": "Float",
      "label": "Weight",
      "non_negative": 1,
      "in_list_view": 1
    },
    {
      "default": "0",
      "fieldname": "is_knockout",
      "fieldtype": "Check",
      "label": "Is Knockout",
      "description": "Hard gate: failing this rule zeroes the score outright. No weighted score can override it."
    },
    {
      "default": "1",
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "in_standard_filter": 1
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    }
  ]
}