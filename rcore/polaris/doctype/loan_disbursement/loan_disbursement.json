{
  "doctype": "DocType",
  "name": "Loan Disbursement",
  "engine": "InnoDB",
  "is_submittable": 1,
  "issingle": 0,
  "istable": 0,
  "editable_grid": 1,
  "module": "polaris",
  "permissions": [
    {
      "create": 1,
      "delete": 1,
      "email": 1,
      "export": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "role": "System Manager",
      "share": 1,
      "write": 1
    },
    {
      "create": 1,
      "delete": 1,
      "email": 1,
      "export": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "role": "Loan Manager",
      "share": 1,
      "submit": 1,
      "cancel": 1,
      "write": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "against_loan",
      "fieldtype": "Link",
      "label": "Against Loan",
      "options": "Loan",
      "reqd": 1
    },
    {
      "fieldname": "applicant_type",
      "fieldtype": "Select",
      "label": "Applicant Type",
      "options": "Customer\nEmployee"
    },
    {
      "fieldname": "applicant",
      "fieldtype": "Dynamic Link",
      "label": "Applicant",
      "options": "applicant_type"
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "Company",
      "options": "Company",
      "reqd": 1
    },
    {
      "fieldname": "currency",
      "fieldtype": "Link",
      "label": "Currency",
      "options": "Currency"
    },
    {
      "fieldname": "loan_product",
      "fieldtype": "Link",
      "label": "Loan Product",
      "options": "Loan Product"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "\nDraft\nSubmitted\nCancelled\nClosed",
      "default": "Draft",
      "in_list_view": 1
    },
    {
      "fieldname": "disbursed_amount",
      "fieldtype": "Currency",
      "label": "Disbursed Amount",
      "options": "currency",
      "reqd": 1
    },
    {
      "fieldname": "disbursement_date",
      "fieldtype": "Date",
      "label": "Disbursement Date",
      "default": "Today",
      "reqd": 1
    },
    {
      "fieldname": "posting_date",
      "fieldtype": "Date",
      "label": "Posting Date",
      "default": "Today"
    },
    {
      "fieldname": "is_term_loan",
      "fieldtype": "Check",
      "label": "Is Term Loan",
      "default": "0"
    },
    {
      "fieldname": "monthly_repayment_amount",
      "fieldtype": "Currency",
      "label": "Monthly Repayment Amount",
      "options": "currency"
    },
    {
      "fieldname": "journal_entry",
      "fieldtype": "Link",
      "label": "Journal Entry",
      "options": "Journal Entry",
      "read_only": 1,
      "no_copy": 1,
      "description": "The GL posting created for this disbursement. Submission is BLOCKED (throws) if the Loan Product's GL accounts aren't configured - matches real upstream Frappe Lending's own behavior, not a new restriction invented by this fork."
    },
    {
      "fieldname": "amended_from",
      "fieldtype": "Link",
      "label": "Amended From",
      "options": "Loan Disbursement",
      "no_copy": 1,
      "print_hide": 1,
      "read_only": 1
    }
  ]
}