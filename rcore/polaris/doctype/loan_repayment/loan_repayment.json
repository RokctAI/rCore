{
  "doctype": "DocType",
  "name": "Loan Repayment",
  "engine": "InnoDB",
  "is_submittable": 1,
  "issingle": 0,
  "istable": 0,
  "editable_grid": 1,
  "module": "polaris",
  "permissions": [
    {
      "create": 1,
      "delete": 1,
      "email": 1,
      "export": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "role": "System Manager",
      "share": 1,
      "write": 1
    },
    {
      "create": 1,
      "delete": 1,
      "email": 1,
      "export": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "role": "Loan Manager",
      "share": 1,
      "submit": 1,
      "cancel": 1,
      "write": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "against_loan",
      "fieldtype": "Link",
      "label": "Against Loan",
      "options": "Loan",
      "reqd": 1
    },
    {
      "fieldname": "applicant_type",
      "fieldtype": "Select",
      "label": "Applicant Type",
      "options": "Customer\nEmployee"
    },
    {
      "fieldname": "applicant",
      "fieldtype": "Dynamic Link",
      "label": "Applicant",
      "options": "applicant_type"
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "Company",
      "options": "Company"
    },
    {
      "fieldname": "currency",
      "fieldtype": "Link",
      "label": "Currency",
      "options": "Currency"
    },
    {
      "fieldname": "loan_product",
      "fieldtype": "Link",
      "label": "Loan Product",
      "options": "Loan Product"
    },
    {
      "fieldname": "repayment_type",
      "fieldtype": "Select",
      "label": "Repayment Type",
      "options": "Normal Repayment\nWrite Off Recovery\nAdvance Payment\nPre Payment\nLoan Closure\nFull Settlement",
      "default": "Normal Repayment"
    },
    {
      "fieldname": "amount_paid",
      "fieldtype": "Currency",
      "label": "Amount Paid",
      "options": "currency",
      "reqd": 1
    },
    {
      "fieldname": "principal_amount_paid",
      "fieldtype": "Currency",
      "label": "Principal Amount Paid",
      "options": "currency"
    },
    {
      "fieldname": "interest_payable",
      "fieldtype": "Currency",
      "label": "Interest Component Paid",
      "options": "currency"
    },
    {
      "fieldname": "pending_principal_amount",
      "fieldtype": "Currency",
      "label": "Pending Principal Amount (after this repayment)",
      "options": "currency",
      "read_only": 1
    },
    {
      "fieldname": "posting_date",
      "fieldtype": "Date",
      "label": "Posting Date",
      "default": "Today"
    },
    {
      "fieldname": "journal_entry",
      "fieldtype": "Link",
      "label": "Journal Entry",
      "options": "Journal Entry",
      "read_only": 1,
      "no_copy": 1,
      "description": "The GL posting created for this repayment. Submission is BLOCKED (throws) if the Loan Product's GL accounts aren't configured."
    },
    {
      "fieldname": "amended_from",
      "fieldtype": "Link",
      "label": "Amended From",
      "options": "Loan Repayment",
      "no_copy": 1,
      "print_hide": 1,
      "read_only": 1
    }
  ]
}