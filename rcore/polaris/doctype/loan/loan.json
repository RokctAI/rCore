      "label": "Currency",
      "options": "Currency"
    },
    {
      "fieldname": "loan_product",
      "fieldtype": "Link",
      "label": "Loan Product",
      "options": "Loan Product",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "\nDraft\nApproved\nSanctioned\nPartially Disbursed\nDisbursed\nActive\nLoan Closure Requested\nClosed\nWritten Off\nSettled",
      "default": "Draft",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "collapsible": 1,
      "fieldname": "section_break_terms",
      "fieldtype": "Section Break",
      "label": "Loan Terms"
    },
    {
      "fieldname": "loan_amount",
      "fieldtype": "Currency",
      "label": "Loan Amount",
      "options": "currency",
      "reqd": 1
    },
    {
      "fieldname": "rate_of_interest",
      "fieldtype": "Percent",
      "label": "Rate of Interest (%) Yearly"
    },
    {
      "default": "0",
      "fieldname": "is_secured_loan",
      "fieldtype": "Check",
      "label": "Is Secured Loan"
    },
    {
      "default": "0",
      "fieldname": "is_term_loan",
      "fieldtype": "Check",
      "label": "Is Term Loan"
    },
    {
      "fieldname": "column_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "repayment_method",
      "fieldtype": "Select",
      "label": "Repayment Method",
      "options": "\nRepay Fixed Amount per Period\nRepay Over Number of Periods",
      "depends_on": "is_term_loan"
    },
    {
      "fieldname": "repayment_periods",
      "fieldtype": "Int",
      "label": "Repayment Periods",
      "non_negative": 1
    },
    {
      "fieldname": "monthly_repayment_amount",
      "fieldtype": "Currency",
      "label": "Monthly Repayment Amount",
      "options": "currency"
    },
    {
      "collapsible": 1,
      "fieldname": "section_break_dates",
      "fieldtype": "Section Break",
      "label": "Dates"
    },
    {
      "fieldname": "posting_date",
      "fieldtype": "Date",
      "label": "Posting Date",
      "default": "Today"
    },
    {
      "fieldname": "disbursement_date",
      "fieldtype": "Date",
      "label": "Disbursement Date",
      "read_only": 1
    },
    {
      "fieldname": "column_break_3",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "closure_date",
      "fieldtype": "Date",
      "label": "Closure Date",
      "read_only": 1
    },
    {
      "collapsible": 1,
      "fieldname": "section_break_balances",
      "fieldtype": "Section Break",
      "label": "Balances (running, system-maintained)"
