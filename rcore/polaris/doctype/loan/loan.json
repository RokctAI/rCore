      "fieldtype": "Check",
      "label": "Is NPA",
      "read_only": 1
    },
    {
      "fieldname": "days_past_due",
      "fieldtype": "Int",
      "label": "Days Past Due",
      "read_only": 1,
      "default": "0"
    },
    {
      "fieldname": "column_break_5",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "classification_code",
