    {
      "fieldname": "disbursed_amount",
      "fieldtype": "Currency",
      "label": "Disbursed Amount",
      "options": "currency",
      "read_only": 1,
      "default": "0"
    },
    {
      "fieldname": "total_payment",
      "fieldtype": "Currency",
      "label": "Total Payment (Expected)",
      "options": "currency",
      "read_only": 1,
      "default": "0"
    },
    {
      "fieldname": "total_interest_payable",
      "fieldtype": "Currency",
      "label": "Total Interest Payable",
      "options": "currency",
      "read_only": 1,
      "default": "0"
    },
    {
      "fieldname": "column_break_4",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "total_principal_paid",
      "fieldtype": "Currency",
      "label": "Total Principal Paid",
      "options": "currency",
      "read_only": 1,
      "default": "0"
    },
    {
      "fieldname": "total_amount_paid",
      "fieldtype": "Currency",
      "label": "Total Amount Paid",
      "options": "currency",
      "read_only": 1,
      "default": "0"
    },
    {
      "fieldname": "written_off_amount",
      "fieldtype": "Currency",
      "label": "Written Off Amount",
      "options": "currency",
      "read_only": 1,
      "default": "0"
    },
    {
      "fieldname": "debit_adjustment_amount",
      "fieldtype": "Currency",
      "label": "Debit Adjustment Amount",
      "options": "currency",
      "read_only": 1,
      "default": "0"
    },
    {
      "fieldname": "credit_adjustment_amount",
      "fieldtype": "Currency",
      "label": "Credit Adjustment Amount",
      "options": "currency",
      "read_only": 1,
      "default": "0"
    },
    {
      "fieldname": "outstanding_amount",
      "fieldtype": "Currency",
      "label": "Outstanding Amount",
      "options": "currency",
      "read_only": 1,
      "default": "0",
      "description": "Mirrors get_pending_principal_amount() - stored (not just computed) so RokctAI_frontend's generic frappe.client.get_list reads (which can't call Python functions) return a real value. Previously always empty/missing before this fork."
    },
    {
      "collapsible": 1,
      "fieldname": "section_break_gl_accounts",
      "fieldtype": "Section Break",
      "label": "GL Accounts (resolved from Loan Product at creation)",
      "description": "Copied from Loan Product when the Loan is created, not looked up fresh each time - so if Loan Product's account configuration changes later, existing loans keep referencing what was configured when they were created (matches how account resolution works in real double-entry systems)."
    },
    {
      "fieldname": "loan_account",
      "fieldtype": "Link",
      "label": "Loans Receivable Account",
      "options": "Account",
      "read_only": 1
    },
    {
      "fieldname": "interest_income_account",
      "fieldtype": "Link",
      "label": "Interest Income Account",
      "options": "Account",
      "read_only": 1
    },
    {
      "fieldname": "column_break_gl",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "interest_accrued_account",
      "fieldtype": "Link",
      "label": "Interest Receivable Account",
      "options": "Account",
      "read_only": 1
    },
    {
      "fieldname": "bank_account",
      "fieldtype": "Link",
      "label": "Bank Account",
      "options": "Account",
      "read_only": 1
    },
    {
      "collapsible": 1,
      "fieldname": "section_break_classification",
