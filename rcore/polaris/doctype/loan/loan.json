      "cancel": 1,
      "write": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "loan_application",
      "fieldtype": "Link",
      "label": "Loan Application",
      "options": "Loan Application"
    },
    {
      "fieldname": "applicant_type",
      "fieldtype": "Select",
      "label": "Applicant Type",
      "options": "Customer\nEmployee",
      "reqd": 1
    },
    {
      "fieldname": "applicant",
      "fieldtype": "Dynamic Link",
      "label": "Applicant",
      "options": "applicant_type",
      "reqd": 1
    },
    {
      "fieldname": "applicant_name",
      "fieldtype": "Data",
      "label": "Applicant Name"
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "Company",
      "options": "Company",
      "reqd": 1
    },
    {
      "fieldname": "branch",
      "fieldtype": "Link",
      "label": "Branch",
      "options": "Branch"
    },
    {
      "fieldname": "currency",
