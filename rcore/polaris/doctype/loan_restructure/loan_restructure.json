    {
      "fieldname": "new_repayment_period_in_months",
      "fieldtype": "Int",
      "label": "New Repayment Period (Months)",
      "non_negative": 1
    },
    {
      "fieldname": "column_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "new_monthly_repayment_amount",
      "fieldtype": "Currency",
      "label": "New Monthly Repayment Amount",
      "options": "currency"
    },
    {
