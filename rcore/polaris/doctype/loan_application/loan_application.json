{
  "doctype": "DocType",
  "name": "Loan Application",
  "engine": "InnoDB",
  "is_submittable": 0,
  "issingle": 0,
  "istable": 0,
  "editable_grid": 1,
  "module": "polaris",
  "permissions": [
    {
      "create": 1,
      "delete": 1,
      "email": 1,
      "export": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "role": "System Manager",
      "share": 1,
      "write": 1
    },
    {
      "create": 1,
      "delete": 1,
      "email": 1,
      "export": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "role": "Loan Manager",
      "share": 1,
      "write": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "applicant_type",
      "fieldtype": "Select",
      "label": "Applicant Type",
      "options": "Customer\nEmployee",
      "default": "Customer",
      "reqd": 1
    },
    {
      "fieldname": "applicant",
      "fieldtype": "Dynamic Link",
      "label": "Applicant",
      "options": "applicant_type",
      "reqd": 1
    },
    {
      "fieldname": "applicant_name",
      "fieldtype": "Data",
      "label": "Applicant Name"
    },
    {
      "fieldname": "applicant_email_address",
      "fieldtype": "Data",
      "label": "Applicant Email Address"
    },
    {
      "fieldname": "applicant_phone_number",
      "fieldtype": "Data",
      "label": "Applicant Phone Number"
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "Company",
      "options": "Company",
      "reqd": 1
    },
    {
      "fieldname": "loan_product",
      "fieldtype": "Link",
      "label": "Loan Product",
      "options": "Loan Product",
      "reqd": 1
    },
    {
      "fieldname": "loan_amount",
      "fieldtype": "Currency",
      "label": "Loan Amount",
      "options": "currency",
      "reqd": 1
    },
    {
      "fieldname": "currency",
      "fieldtype": "Link",
      "label": "Currency",
      "options": "Currency"
    },
    {
      "fieldname": "posting_date",
      "fieldtype": "Date",
      "label": "Posting Date",
      "default": "Today"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nSubmitted\nApproved\nRejected\nDisbursed",
      "default": "Draft",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "collapsible": 1,
      "fieldname": "section_break_repayment",
      "fieldtype": "Section Break",
      "label": "Repayment Terms"
    },
    {
      "default": "0",
      "fieldname": "is_term_loan",
      "fieldtype": "Check",
      "label": "Is Term Loan"
    },
    {
      "fieldname": "rate_of_interest",
      "fieldtype": "Percent",
      "label": "Rate of Interest (%) Yearly"
    },
    {
      "depends_on": "is_term_loan",
      "fieldname": "repayment_method",
      "fieldtype": "Select",
      "label": "Repayment Method",
      "options": "\nRepay Fixed Amount per Period\nRepay Over Number of Periods"
    },
    {
      "fieldname": "column_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "repayment_periods",
      "fieldtype": "Int",
      "label": "Repayment Periods",
      "non_negative": 1
    },
    {
      "fieldname": "repayment_amount",
      "fieldtype": "Currency",
      "label": "Repayment Amount",
      "options": "currency"
    },
    {
      "fieldname": "total_payable_amount",
      "fieldtype": "Currency",
      "label": "Total Payable Amount",
      "options": "currency",
      "read_only": 1
    },
    {
      "fieldname": "total_payable_interest",
      "fieldtype": "Currency",
      "label": "Total Payable Interest",
      "options": "currency",
      "read_only": 1
    },
    {
      "collapsible": 1,
      "fieldname": "section_break_affordability",
      "fieldtype": "Section Break",
      "label": "Affordability (NCA assessment)"
    },
    {
      "fieldname": "monthly_income",
      "fieldtype": "Currency",
      "label": "Monthly Income",
      "options": "currency",
      "description": "Declared monthly income. Required input for the credit decision engine's mandatory NCA affordability assessment (docs/credit-risk-algorithm.md) - the engine returns Pending, never a fabricated score, while this is missing or zero."
    },
    {
      "fieldname": "column_break_affordability",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "monthly_expenses",
      "fieldtype": "Currency",
      "label": "Monthly Expenses",
      "options": "currency",
      "description": "Declared total monthly expenses. Used with Monthly Income by the credit decision engine's affordability gate and affordability-ratio component."
    },
    {
      "collapsible": 1,
      "fieldname": "section_break_collateral",
      "fieldtype": "Section Break",
      "label": "Collateral (secured loans only)"
    },
    {
      "default": "0",
      "fieldname": "is_secured_loan",
      "fieldtype": "Check",
      "label": "Is Secured Loan"
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Collateral Description",
      "depends_on": "is_secured_loan",
      "description": "Field name matches RokctAI_frontend's application/new/page.tsx exactly (formData.description) - that page passes form data straight through to frappe.client.insert with no field renaming, so this name is load-bearing, not a style choice."
    },
    {
      "fieldname": "declared_asset_value",
      "fieldtype": "Currency",
      "label": "Declared Asset Value",
      "options": "currency",
      "depends_on": "is_secured_loan",
      "description": "Not currently populated by the live application form (it only captures the free-text description above) - a real gap, not silently assumed handled. Available here so the form can be extended to capture it without a further backend change."
    },
    {
      "collapsible": 1,
      "fieldname": "section_break_mobile",
      "fieldtype": "Section Break",
      "label": "Mobile / KYC"
    },
    {
      "default": "0",
      "fieldname": "is_from_mobile",
      "fieldtype": "Check",
      "label": "Is From Mobile"
    },
    {
      "default": "0",
      "fieldname": "skip_documents",
      "fieldtype": "Check",
      "label": "Skip Documents"
    },
    {
      "fieldname": "column_break_3",
      "fieldtype": "Column Break"
    },
    {
      "default": "0",
      "fieldname": "is_ring_fenced",
      "fieldtype": "Check",
      "label": "Is Ring Fenced",
      "read_only": 1
    },
    {
      "default": "0",
      "fieldname": "is_withdrawable",
      "fieldtype": "Check",
      "label": "Is Withdrawable",
      "read_only": 1
    },
    {
      "fieldname": "trace_id",
      "fieldtype": "Data",
      "label": "Trace ID",
      "hidden": 1
    }
  ]
}