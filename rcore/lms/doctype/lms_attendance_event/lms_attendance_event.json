{
  "doctype": "DocType",
  "name": "LMS Attendance Event",
  "engine": "InnoDB",
  "istable": 0,
  "module": "rlms",
  "autoname": "hash",
  "fields": [
    {
      "fieldname": "student",
      "fieldtype": "Link",
      "label": "Student",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "session_id",
      "fieldtype": "Data",
      "label": "Session ID",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Replay Session id this event is about"
    },
    {
      "fieldname": "outcome",
      "fieldtype": "Select",
      "label": "Outcome",
      "options": "Attended\nSkipped Answered\nSkipped Unanswered",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "occurred_at",
      "fieldtype": "Datetime",
      "label": "Occurred At",
      "reqd": 1
    },
    {
      "fieldname": "data_used_mb",
      "fieldtype": "Float",
      "label": "Data Used (MB)",
      "default": "0",
      "description": "The session's estimated sync-traffic megabytes, synced from the on-device \u00a75 ledger"
    },
    {
      "fieldname": "seconds_watched",
      "fieldtype": "Int",
      "label": "Seconds Watched",
      "description": "How many seconds of the session the student actually watched (presence-with-gaps attendance). Optional and gap-tolerant: absent/0 means unknown, not zero. Seconds convention matches Replay Session.duration_seconds; the client surfaces it as x/60 minutes."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "create": 1,
      "write": 1,
      "delete": 1
    },
    {
      "role": "All",
      "read": 1,
      "create": 1,
      "if_owner": 1
    }
  ]
}