{
  "doctype": "DocType",
  "name": "LMS Lesson Quiz Result",
  "engine": "InnoDB",
  "istable": 0,
  "module": "rlms",
  "autoname": "hash",
  "fields": [
    {
      "fieldname": "lesson",
      "fieldtype": "Link",
      "label": "Lesson",
      "options": "Course Lesson",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "member",
      "fieldtype": "Link",
      "label": "Member",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "subtopic_ref",
      "fieldtype": "Data",
      "label": "Subtopic Ref",
      "description": "Subtopic boundary id from the lesson manifest this question belongs to"
    },
    {
      "fieldname": "question_id",
      "fieldtype": "Data",
      "label": "Question ID",
      "reqd": 1,
      "description": "MCQ question id from the content-pipeline manifest \u2014 questions are manifest-authored, not Frappe-authored"
    },
    {
      "fieldname": "outcome",
      "fieldtype": "Select",
      "label": "Outcome",
      "options": "Correct\nIncorrect\nSkipped",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "selected_index",
      "fieldtype": "Int",
      "label": "Selected Index",
      "description": "Index of the option the student picked; empty when skipped"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "create": 1,
      "write": 1,
      "delete": 1
    },
    {
      "role": "All",
      "read": 1,
      "create": 1,
      "if_owner": 1
    }
  ]
}