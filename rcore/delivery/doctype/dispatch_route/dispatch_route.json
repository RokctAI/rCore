{
  "doctype": "DocType",
  "name": "Dispatch Route",
  "engine": "InnoDB",
  "istable": 0,
  "module": "delivery",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ],
  "fields": [
    {
      "fieldname": "deliveryman",
      "fieldtype": "Link",
      "label": "Deliveryman",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "mode",
      "fieldtype": "Select",
      "label": "Mode",
      "options": "Pickup\nDelivery",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nAssigned\nIn Progress\nCompleted\nCancelled",
      "default": "Draft",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "optimize_order",
      "fieldtype": "Check",
      "label": "Optimize Stop Order",
      "default": "1",
      "description": "When checked, the driver app orders the stops nearest-first from the driver's position; when unchecked the stops are driven exactly in the order below."
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "Notes"
    },
    {
      "fieldname": "stops",
      "fieldtype": "Table",
      "label": "Stops",
      "options": "Dispatch Route Stop",
      "reqd": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1
}