{
  "name": "Provider Pickup Location",
  "doctype": "DocType",
  "engine": "InnoDB",
  "istable": 0,
  "module": "delivery",
  "fields": [
    {
      "fieldname": "provider",
      "fieldtype": "Data",
      "label": "Provider",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "reference",
      "fieldtype": "Data",
      "label": "Reference",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "provider_ref",
      "fieldtype": "Data",
      "label": "Provider-side Reference"
    },
    {
      "fieldname": "user",
      "fieldtype": "Link",
      "label": "User",
      "options": "User"
    },
    {
      "fieldname": "normalized_address",
      "fieldtype": "Small Text",
      "label": "Normalized Address"
    },
    {
      "fieldname": "refcount",
      "fieldtype": "Int",
      "label": "In-flight Shipments",
      "default": "0"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Active\nInactive",
      "default": "Active",
      "in_list_view": 1
    },
    {
      "fieldname": "release_after",
      "fieldtype": "Datetime",
      "label": "Release After",
      "description": "When the grace period lapses and the provider-side record may be deleted."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}