{
  "doctype": "DocType",
  "name": "Parcel Order",
  "engine": "InnoDB",
  "istable": 0,
  "module": "delivery",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "PaaS User",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "permlevel": 0,
      "if_owner": 1
    }
  ],
  "fields": [
    {
      "fieldname": "user",
      "fieldtype": "Link",
      "label": "User",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "parcel_type",
      "fieldtype": "Link",
      "label": "Parcel Type",
      "options": "Parcel Order Setting",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "parcel_option",
      "fieldtype": "Link",
      "label": "Parcel Option",
      "options": "Parcel Option"
    },
    {
      "fieldname": "deliveryman",
      "fieldtype": "Link",
      "label": "Deliveryman",
      "options": "User"
    },
    {
      "fieldname": "order",
      "fieldtype": "Link",
      "label": "Linked Order",
      "options": "Order"
    },
    {
      "fieldname": "delivery_point",
      "fieldtype": "Link",
      "label": "Delivery Point",
      "options": "Delivery Point"
    },
    {
      "fieldname": "total_price",
      "fieldtype": "Currency",
      "label": "Total Price",
      "reqd": 1
    },
    {
      "fieldname": "currency",
      "fieldtype": "Link",
      "label": "Currency",
      "options": "Currency"
    },
    {
      "fieldname": "delivery_fee",
      "fieldtype": "Currency",
      "label": "Delivery Fee"
    },
    {
      "fieldname": "tax",
      "fieldtype": "Currency",
      "label": "Tax"
    },
    {
      "fieldname": "address_from",
      "fieldtype": "Data",
      "label": "Address From",
      "reqd": 1
    },
    {
      "fieldname": "address_to",
      "fieldtype": "Data",
      "label": "Address To",
      "reqd": 1
    },
    {
      "fieldname": "delivery_date",
      "fieldtype": "Date",
      "label": "Delivery Date"
    },
    {
      "fieldname": "delivery_time",
      "fieldtype": "Data",
      "label": "Delivery Time"
    },
    {
      "fieldname": "note",
      "fieldtype": "Text",
      "label": "Note"
    },
    {
      "fieldname": "phone_from",
      "fieldtype": "Data",
      "label": "Phone From"
    },
    {
      "fieldname": "phone_to",
      "fieldtype": "Data",
      "label": "Phone To"
    },
    {
      "fieldname": "username_to",
      "fieldtype": "Data",
      "label": "Username To"
    },
    {
      "fieldname": "username_from",
      "fieldtype": "Data",
      "label": "Username From"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "New\nAccepted\nReady\nOn a way\nDelivered\nCanceled",
      "default": "New"
    },
    {
      "fieldname": "items",
      "fieldtype": "Table",
      "label": "Items",
      "options": "Parcel Order Item"
    },
    {
      "fieldname": "offline_uuid",
      "fieldtype": "Data",
      "label": "Offline UUID",
      "unique": 1
    },
    {
      "fieldname": "fulfilment_mode",
      "fieldtype": "Select",
      "label": "Fulfilment Mode",
      "options": "last_mile\nintercity",
      "default": "last_mile"
    },
    {
      "fieldname": "provider",
      "fieldtype": "Data",
      "label": "Logistics Provider"
    },
    {
      "fieldname": "provider_shipment_ref",
      "fieldtype": "Data",
      "label": "Provider Shipment Ref"
    },
    {
      "fieldname": "waybill_no",
      "fieldtype": "Data",
      "label": "Waybill No"
    },
    {
      "fieldname": "tracking_url",
      "fieldtype": "Data",
      "label": "Tracking URL"
    },
    {
      "fieldname": "declared_value",
      "fieldtype": "Currency",
      "label": "Declared Value",
      "description": "Required for intercity parcels; liability caps are keyed off it."
    },
    {
      "fieldname": "cod_amount",
      "fieldtype": "Currency",
      "label": "COD Amount"
    },
    {
      "fieldname": "cod_collected_amount",
      "fieldtype": "Currency",
      "label": "COD Collected Amount",
      "read_only": 1,
      "description": "Cash the deliveryman confirmed collecting from the recipient."
    },
    {
      "fieldname": "cod_settled",
      "fieldtype": "Check",
      "label": "COD Settled",
      "default": "0",
      "read_only": 1,
      "description": "Set once the collected cash has been moved from the deliveryman's wallet to the sender's wallet; guards against double settlement."
    }
  ]
}