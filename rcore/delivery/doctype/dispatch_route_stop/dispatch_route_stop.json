{
  "doctype": "DocType",
  "name": "Dispatch Route Stop",
  "engine": "InnoDB",
  "istable": 1,
  "editable_grid": 1,
  "module": "delivery",
  "permissions": [],
  "fields": [
    {
      "fieldname": "shop",
      "fieldtype": "Link",
      "label": "Shop",
      "options": "Shop",
      "in_list_view": 1,
      "description": "Optional. When set and no coordinates are entered, the stop's coordinates come from the shop's location."
    },
    {
      "fieldname": "label",
      "fieldtype": "Data",
      "label": "Label",
      "in_list_view": 1
    },
    {
      "fieldname": "latitude",
      "fieldtype": "Float",
      "label": "Latitude"
    },
    {
      "fieldname": "longitude",
      "fieldtype": "Float",
      "label": "Longitude"
    },
    {
      "fieldname": "quantity",
      "fieldtype": "Float",
      "label": "Quantity",
      "in_list_view": 1
    },
    {
      "fieldname": "unit",
      "fieldtype": "Data",
      "label": "Unit",
      "in_list_view": 1,
      "description": "e.g. bottles"
    },
    {
      "fieldname": "note",
      "fieldtype": "Data",
      "label": "Note"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Pending\nDone\nSkipped",
      "default": "Pending",
      "in_list_view": 1
    },
    {
      "fieldname": "completed_at",
      "fieldtype": "Datetime",
      "label": "Completed At",
      "read_only": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1
}