{
  "doctype": "DocType",
  "name": "Deliveryman Profile",
  "engine": "InnoDB",
  "is_submittable": 0,
  "issingle": 0,
  "istable": 0,
  "module": "delivery",
  "permissions": [
    {
      "create": 1,
      "delete": 1,
      "email": 1,
      "export": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "role": "System Manager",
      "share": 1,
      "write": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "user",
      "fieldtype": "Link",
      "label": "User",
      "options": "User",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "online",
      "fieldtype": "Check",
      "label": "Online",
      "default": "0"
    },
    {
      "fieldname": "latitude",
      "fieldtype": "Float",
      "label": "Latitude"
    },
    {
      "fieldname": "longitude",
      "fieldtype": "Float",
      "label": "Longitude"
    },
    {
      "fieldname": "car_model",
      "fieldtype": "Data",
      "label": "Car Model"
    },
    {
      "fieldname": "car_number",
      "fieldtype": "Data",
      "label": "Car Number"
    },
    {
      "fieldname": "color",
      "fieldtype": "Data",
      "label": "Color"
    },
    {
      "fieldname": "can_convert_cod_to_credit",
      "fieldtype": "Check",
      "label": "Can Convert COD To Credit",
      "default": "0",
      "description": "Allow this deliveryman to convert a cash order to Credit on delivery"
    }
  ]
}